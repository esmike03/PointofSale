APP_NAME=POS
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_OUTPUT_OF_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://pos.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database
SANCTUM_STATEFUL_DOMAINS=
ALLOW_PUBLIC_REGISTRATION=false

POS_PORT=8080
POS_DB_DATABASE=pos
POS_DB_USERNAME=pos
POS_DB_PASSWORD=replace-with-a-long-random-password
POS_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
